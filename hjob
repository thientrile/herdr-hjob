#!/usr/bin/env python3
"""hjob: run a long command in the background and wake the agent when it ends.

    hjob [--name NAME] [--pane PANE_ID] [--wait SECONDS] -- command args...
    hjob status [JOB_ID]

Runs the command. If it ends within --wait seconds (default 25) its output tail and exit
code are printed and nothing else happens. If it is still running, hjob returns and the
command keeps running in the background; when it exits hjob hands one fixed line (job name,
exit code, time) to `wake enqueue` (herdr-wake), which prompts the agent working in the job's
directory once it is idle, and herdr shows a notification. Nothing from the command's output
is ever put in that line. Every hjob call retries jobs whose enqueue failed.
"""
import glob, json, os, re, shutil, subprocess, sys, tempfile, time

STATE = os.path.expanduser("~/.local/state/hjob")
HERDR = os.environ.get("HERDR_BIN_PATH") or "herdr"
WAKE = os.environ.get("HERDR_WAKE_BIN") or "wake"
DRY = os.environ.get("HJOB_DRY_RUN") == "1"
safe = lambda v, n=40: re.sub(r"[^A-Za-z0-9._ -]", "", str(v))[:n].strip() or "job"


ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
ERRORS = re.compile(r"error|fail|✗|exception|traceback|npm err|err!|panic|fatal", re.I)


def digest(log, code, tail_n=40, max_errors=15):
    """ANSI-free tail, plus up to max_errors error-looking lines from earlier in the log."""
    lines = [ANSI.sub("", l.rstrip("\n")) for l in open(log, errors="replace")]
    start = max(0, len(lines) - tail_n)
    out = [f"[hjob] log has {len(lines)} lines; showing the last {len(lines) - start}"] if start else []
    out += lines[start:]
    if code != 0:
        earlier = [f"{n}: {l[:200]}" for n, l in enumerate(lines[:start], 1) if ERRORS.search(l)][:max_errors]
        if earlier:
            out += [f"[hjob] earlier error-looking lines (line: text), first {len(earlier)}:"] + earlier
            out.append(f"[hjob] read around one with: sed -n 'A,Bp' {log}")
    return "\n".join(out)


def herdr(*args):
    """True only when herdr ran and exited 0; a missing binary or a timeout is a failure, never an exception."""
    if DRY:
        print("DRY-RUN herdr", *args, flush=True)
        return True
    try:
        return subprocess.run([HERDR, *args], capture_output=True, timeout=30).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def alive(pid):
    """True while pid is an hjob worker; on Linux a pid reused by another process (e.g. after a reboot) is not."""
    if os.path.isdir("/proc/self"):
        try:
            args = open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0")
        except OSError:
            return False
        return args[3:4] == [b"--worker"] and os.path.basename(args[2]) == b"hjob"  # python -I .../hjob --worker
    try:  # shortcut: macOS has no /proc, so a reused pid reads as alive and delays job_failed; upgrade if seen
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    return True


def load(path, need):
    """The JSON object at path if it has every key in need with the given type, else None."""
    try:
        d = json.load(open(path))
    except (OSError, ValueError):
        return None
    return d if isinstance(d, dict) and all(isinstance(d.get(k), t) for k, t in need.items()) else None


DETACHED = {"pid": int, "name": str, "cwd": str, "pane": str}  # .detached: the job's meta plus its worker pid
RESULT = {"exit": int}  # .json: written by the worker when the command ends


def enqueue(base, d):
    """Hand a detached job that ended (or whose worker died) to herdr-wake and record how that went.

    .enqueued: stored (or duplicate); .enqueue-error: wake rejected the call (exit 2), a bug, not retried;
    .enqueue-retry: nothing stored (exit 1, missing wake, timeout). Returns wake's exit code, None if it did not run."""
    job, r = os.path.basename(base), load(base + ".json", RESULT)
    if r:
        kind, text = "job_done" if r["exit"] == 0 else "job_failed", f"job '{d['name']}' finished with exit {r['exit']} in {r.get('seconds', '?')}s"
    else:  # no (complete) result: the worker died before writing it
        kind, text = "job_failed", f"job '{d['name']}' lost its hjob worker, no result recorded; the command may still be running"
    cmd = [WAKE, "enqueue", "--source", "hjob", "--id", job, "--cwd", d["cwd"], "--kind", kind, "--text", text,
           "--hint", f"hjob status {job}"] + (["--pane-hint", d["pane"]] if d["pane"] else [])
    with tempfile.TemporaryFile("w+") as out:  # a file, not a pipe: a child of wake holding the pipe cannot outlast the timeout
        try:
            code = subprocess.run(cmd, stdout=out, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, timeout=10).returncode
        except (OSError, subprocess.TimeoutExpired) as e:
            code = None
            out.write(f"{type(e).__name__}: {e}")
        out.seek(0)
        msg = out.read(300).strip()
    mark = {0: ".enqueued", 2: ".enqueue-error"}.get(code, ".enqueue-retry")
    with open(base + mark, "w") as f:
        f.write(f"{time.strftime('%FT%T')} exit {code}: {msg}\n")
    if code in (0, 2) and os.path.exists(base + ".enqueue-retry"):
        os.remove(base + ".enqueue-retry")
    return code


def settled(base):
    return os.path.exists(base + ".enqueued") or os.path.exists(base + ".enqueue-error")


def tracked(unsettled=False):
    """(base, detach record) of the detached jobs this hjob version tracks, oldest first."""
    for f in sorted(glob.glob(f"{STATE}/*.detached")):
        d = None if unsettled and settled(f[:-9]) else load(f, DETACHED)
        if d:  # an older hjob left an empty marker: not tracked
            yield f[:-9], d


def retry():
    """Enqueue every unsettled job whose worker is gone (a live worker retries its own job), within ~10 s per call."""
    deadline = time.time() + 10
    for base, d in tracked(unsettled=True):
        if time.time() > deadline:
            return
        if not alive(d["pid"]) and enqueue(base, d) is None:
            return  # wake missing or hanging: the rest would fail the same way


def wake_state(base):
    for mark, label in ((".enqueued", "enqueued"), (".enqueue-error", "ENQUEUE ERROR, not retried"),
                        (".enqueue-retry", "NOT ENQUEUED, retried on the next hjob call")):
        if os.path.exists(base + mark):
            return f"{label} ({open(base + mark).read().strip()})"
    d = load(base + ".detached", DETACHED)
    if d and alive(d["pid"]):
        return "running"
    return "finished, not enqueued yet" if load(base + ".json", RESULT) else "its hjob worker died, not enqueued yet"


def status(job):
    if not job:
        jobs = list(tracked())
        for base, _ in [j for j in jobs[:-20] if not os.path.exists(j[0] + ".enqueued")] + jobs[-20:]:
            print(f"{os.path.basename(base)}  {wake_state(base)}")
        return
    if not re.fullmatch(r"[A-Za-z0-9._-]+", job) or not os.path.exists(f"{STATE}/{job}.log"):
        sys.exit(f"hjob status: no job {job} in {STATE}")
    summary(f"{STATE}/{job}.log")
    print(f"[hjob] wake: {wake_state(STATE + '/' + job)}")


def summary(log):
    base, r = log[:-4], load(log[:-4] + ".json", RESULT)
    d = None if r else load(base + ".detached", DETACHED)
    end = f"exit {r['exit']}" if r else "no result: its hjob worker died" if d and not alive(d["pid"]) else "still running"
    print(digest(log, r["exit"] if r else -1) + f"\n[hjob] {end}")


def worker(meta, cmd):
    start = time.time()
    with open(meta["log"], "ab") as log:
        code = subprocess.run(cmd, stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL).returncode
    secs = int(time.time() - start)
    meta.update(exit=code, seconds=secs, finished=time.strftime("%FT%T"))
    json.dump(meta, open(meta["log"][:-4] + ".json", "w"))
    base = meta["log"][:-4]
    for _ in range(30):  # the caller either collected the result or detached; default after 3 s: notify
        if os.path.exists(base + ".collected"):
            return
        if os.path.exists(base + ".detached"):
            break
        time.sleep(0.1)
    d = dict(meta, pid=os.getpid())
    if not os.path.exists(base + ".detached"):  # the caller vanished before deciding: track the job anyway
        json.dump(d, open(base + ".detached", "w"))
    ok = enqueue(base, d) in (0, 2)
    verdict = "done" if code == 0 else f"FAILED (exit {code})"
    herdr("notification", "show", f"{meta['name']}: {verdict} in {secs}s", "--sound", "done" if code == 0 else "request")
    if os.environ.get("HJOB_NOTIFY_CMD") and not DRY:  # optional extra channel, e.g. a Telegram script
        try:  # a broken notifier must not stop the agent wake-up below
            subprocess.run([os.environ["HJOB_NOTIFY_CMD"], f"Job {meta['name']}: {verdict} in {secs}s"], capture_output=True, timeout=15)
        except (OSError, subprocess.TimeoutExpired):
            pass
    for delay in (30, 60, 120, 240):  # wake may be restarting: keep trying a while; once this worker exits, retry() takes over
        if ok:
            break
        time.sleep(delay)
        ok = enqueue(base, d) in (0, 2)


def main():
    argv = sys.argv[1:]
    if argv[:1] != ["--worker"] and os.path.isdir(STATE):
        try:  # jobs whose enqueue failed earlier, or that ended while nothing was watching
            retry()
        except Exception as e:  # best effort over state files on disk: never stop the user's command
            print(f"[hjob] retrying wake enqueues failed: {e}", file=sys.stderr)
    if argv[:1] == ["status"] and len(argv) <= 2:
        return status(argv[1] if len(argv) == 2 else "")
    if argv[:1] == ["--summary"] and len(argv) == 2:
        log = argv[1]
        if not log.startswith(STATE + "/") or not log.endswith(".log"):
            sys.exit("hjob --summary takes a log path under " + STATE)
        return summary(log)
    name, pane, worker_mode, wait = "job", "", False, 25
    while argv and argv[0] != "--":
        flag = argv.pop(0)
        if flag == "--name": name = safe(argv.pop(0))
        elif flag == "--pane": pane = argv.pop(0)
        elif flag == "--wait": wait = int(argv.pop(0))
        elif flag == "--worker": worker_mode = True
        else: sys.exit(f"unknown option {flag}")
    if not argv or argv.pop(0) != "--" or not argv:
        sys.exit("usage: hjob [--name NAME] [--pane ID] [--wait SECONDS] -- command args... | hjob status [JOB_ID]")
    os.makedirs(STATE, exist_ok=True)
    if worker_mode:
        meta = json.loads(os.environ.pop("HJOB_META"))
        return worker(meta, argv)
    job = time.strftime("%Y%m%d-%H%M%S") + f"-{os.getpid()}-" + re.sub(r"\s+", "_", name)  # pid: two jobs with one label in one second stay apart
    meta = {"name": name, "log": f"{STATE}/{job}.log", "pane": pane or os.environ.get("HERDR_PANE_ID", ""), "cwd": os.getcwd(), "cmd": argv[0]}
    env = dict(os.environ, HJOB_META=json.dumps(meta))
    proc = subprocess.Popen([sys.executable, "-I", os.path.abspath(__file__), "--worker", "--", *argv], env=env,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    base, deadline = meta["log"][:-4], time.time() + wait
    while time.time() < deadline and not os.path.exists(base + ".json"):
        time.sleep(0.2)
    if os.path.exists(base + ".json"):
        open(base + ".collected", "w").close()
        result = json.load(open(base + ".json"))
        print(f"{digest(meta['log'], result['exit'])}\n[hjob] exit {result['exit']} in {result['seconds']}s. Log: {meta['log']}")
        sys.exit(result["exit"])
    json.dump(dict(meta, pid=proc.pid), open(base + ".detached", "w"))
    print(f"[hjob] '{name}' is still running after {wait}s, so it continues in the background. Log: {meta['log']}. "
          + ("When it ends, herdr-wake prompts the agent working in this directory once it is idle (`hjob status` shows it). "
             "Do not poll or sleep; finish your turn." if shutil.which(WAKE) else
             "herdr-wake (`wake`) is not installed, so no agent wake-up comes, only a herdr notification; check `hjob status` later."))


main()
